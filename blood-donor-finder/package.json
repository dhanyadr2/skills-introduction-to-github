{
  "name": "blood-donor-finder",
  "version": "0.1.0",
  "description": "Find blood banks and willing blood donors near a ZIP / PIN code (India and United States).",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "import:postal": "node --disable-warning=ExperimentalWarning scripts/import-postal-codes.js",
    "import:banks": "node --disable-warning=ExperimentalWarning scripts/import-blood-banks.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.0.12"
  }
}
