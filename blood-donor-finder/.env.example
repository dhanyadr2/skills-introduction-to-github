# Copy to .env (or export these variables) and adjust.
PORT=3000
# Public URL used in email links.
BASE_URL=http://localhost:3000
# SQLite database file.
DB_PATH=./data/app.db
# Load demo postal codes, blood banks and donors into an empty database.
SEED_DEMO=true
# Look up postal codes that are not in the local table via api.zippopotam.us.
GEOCODER_REMOTE=true

# Email. Leave SMTP_HOST empty to keep emails in the local dev outbox
# (viewable at /dev/outbox) instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Blood Donor Finder <no-reply@example.com>"

# Behind a hosting proxy (Render, Railway, nginx…) set this so per-IP rate limits
# see each visitor's real IP instead of the proxy's: "true", or a hop count like "1".
TRUST_PROXY=
# Protect /dev/outbox with a password (any username) when the app is reachable by others.
OUTBOX_PASSWORD=

# Live blood bank sources.
# OpenStreetMap (no key; both countries): looked up on each search and cached for 24 hours.
OSM_LIVE=true
# India blood bank directory from data.gov.in, downloaded on startup and then daily.
# Free API key: sign in at https://data.gov.in -> My Account -> API key.
# Resource ID: open the "Blood Bank Directory" dataset on data.gov.in; its API URL ends in /resource/<id>.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=
